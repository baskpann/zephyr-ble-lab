/ {
	chosen {
		zephyr,bt-hci = &bt_hci_uart;
	};
};

&usart3 {
	pinctrl-0 = <&usart3_tx_pb10 &usart3_rx_pb11
			&usart3_cts_pb13 &usart3_rts_pb14>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";

	bt_hci_uart: bt_hci_uart {
		compatible = "zephyr,bt-hci-uart";
		status = "okay";
	};
};
